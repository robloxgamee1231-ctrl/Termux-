# Optional: give the site's relay a provider key so visitors don't need their own.
# Never commit a real .env — it is gitignored.

# OpenRouter (https://openrouter.ai/keys) — used for the "OpenRouter" provider.
OPENROUTER_API_KEY=

# OpenAI (https://platform.openai.com/api-keys) — used for the "OpenAI" provider.
OPENAI_API_KEY=

# Shared fallback accepted for either provider.
OPENCODE_API_KEY=

# Local OpenAI-compatible gateway (opencode2api, vLLM, Ollama shim, ...).
# Loopback and private-network hosts only. When set, visitors can connect to it
# without typing a URL.
OPENCODE_LOCAL_BASE=http://127.0.0.1:8080/v1

# Optional bearer token for the local gateway (e.g. opencode2api's local-test-key).
OPENCODE_LOCAL_KEY=

# Legacy alias for OPENCODE_LOCAL_BASE.
OPENCODE_API_BASE=

# `npm start` only — keep away from 8080, which opencode2api already uses.
PORT=3000
