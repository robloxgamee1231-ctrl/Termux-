# Optional: give the site's relay a provider key so visitors don't need their own.
# Never commit a real .env — it is gitignored.

# OpenRouter (https://openrouter.ai/keys) — used for the "OpenRouter" provider.
OPENROUTER_API_KEY=

# OpenAI (https://platform.openai.com/api-keys) — used for the "OpenAI" provider.
OPENAI_API_KEY=

# Shared fallback accepted for either provider.
OPENCODE_API_KEY=

# Point the relay at a self-hosted OpenAI-compatible endpoint or a local mock.
# Leave empty in normal use.
OPENCODE_API_BASE=

# `npm start` only
PORT=8080
